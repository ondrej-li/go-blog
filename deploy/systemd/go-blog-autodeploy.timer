# /etc/systemd/system/go-blog-autodeploy.timer
# Installed and enabled by deploy/deploy.sh.
[Unit]
Description=go.ondralinek.cz — check GitHub every 5 minutes

[Timer]
OnBootSec=2min
OnUnitActiveSec=5min
RandomizedDelaySec=20s
AccuracySec=30s
Persistent=true
Unit=go-blog-autodeploy.service

[Install]
WantedBy=timers.target
